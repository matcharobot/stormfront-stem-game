 {id:'Review',key:'review',no:'04',city:'Huiwan centre',title:'When the river rises',terrain:'Urban system / Outlet constraints',time:'JOINT STORM DRILL / NOW',image:'04-huiwan-downtown',person:'engineer',question:'Why can the same system pass at low river level and fail at high level?',quote:'The report is real. So is Mrs. Chen’s photograph. The outlet conditions were different. Retest at today’s river level.',
 nodes:[{id:'in',x:13,y:29,label:'Upstream entrance',desc:'All three earlier engineering decisions carry into this district.'},{id:'old',x:32,y:66,label:'Old Street',desc:'Classroom target: cumulative overflow ≤ 6 m³ over the 100-minute drill.'},{id:'corridor',x:60,y:36,label:'Transit Walk',desc:'The same cumulative overflow target applies to this transport corridor.'},{id:'river',x:89,y:12,label:'River outlet (off-map)',desc:'Old test: 32 m³ per round. Today’s high river level: 16 m³ per round.'}],paths:['M130 290 Q240 480 320 660','M130 290 Q380 190 600 360','M320 660 Q680 650 890 120','M600 360 Q760 290 890 120']}
 ],
