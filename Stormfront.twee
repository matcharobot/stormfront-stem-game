kground:none;border:1px solid #bbcbb0;border-radius:3px;padding:12px;color:var(--ink);text-align:left}.metric-chip>span{font-size:13px;line-height:1.4;color:#75906a}.metric-chip>b{font-family:var(--serif);font-weight:400;font-size:22px;line-height:1.2;color:var(--teal)}.metric-chip.selected{background:#e4edda;border-color:var(--teal);box-shadow:inset 2px 0 var(--teal)}.metric-chip:hover{background:#edf1e4}.metric-choices .metric-chip{padding:10px}.metric-choices .metric-chip>b{font-size:18px}.council-task>.callout{margin-top:14px;font-size:14px}
/* Evidence-based case statement: two screens instead of smaller text. */
.report-connect>h2,.report-select>h2{font-size:30px}.report-connect>.answer{font-size:17px;margin:14px 0;padding:16px 18px}.report-connect>.feedback{margin-top:22px}.report-metrics{display:grid;grid-template-columns:1fr 1fr;gap:15px;margin-top:26px}.report-metrics>.metric-chip{height:100px;padding:15px}.report-metrics>.metric-chip>span{font-size:16px}.report-metrics>.metric-chip>b{font-size:30px}.report-writing>.field-label{font-size:16px;line-height:1.4;margin:0 0 8px}.report-writing>.word-note+.field-label{margin-top:18px}.report-writing .review-text{height:145px;font-size:17px;line-height:1.5}.report-writing .review-text.short{height:102px}.report-writing>.hint{font-size:13px;margin-top:9px}.chosen-result{margin:16px 0 25px;padding-bottom:20px;border-bottom:1px solid var(--line)}.chosen-result>span{font-size:16px;color:#78906a;display:block}.chosen-result>strong{font-family:var(--serif);font-size:45px;font-weight:400;color:var(--teal);display:block;line-height:1.3;margin-top:5px}.report-rubric>h2{font-size:30px}.report-rubric ul{font-size:17px;line-height:1.5;padding-left:24px;color:#697e5f}.report-rubric li{margin-bottom:13px}.report-rubric>.callout{font-size:14px;margin-top:18px}
.completion-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:22px;height:439px}.completion-card{display:flex;flex-direction:column;padding:23px}.completion-card>h2{font-size:32px;line-height:1.2;margin:20px 0}.completion-card>p{font-size:18px;line-height:1.5}.completion-card>.tag{align-self:start;margin-top:23px;font-size:11px}.completion-card>.btn{margin-top:auto}.process-check{display:flex;align-items:center;gap:16px;flex-wrap:wrap;margin-top:18px;font-size:14px;line-height:1.4;color:#6c8560}.process-check>span:last-child{margin-left:auto}.process-check .text-btn{font-size:13px}
/* Preserve the larger type by reducing redundant card subtitles and spacing. */
.final-choices .choice>small{display:none}.council-context .review-stages{margin:14px 0}.council-context .proposal-card{padding:12px 15px;margin-bottom:11px}
.game-main{padding-top:74px}.mission-screen>.screen-heading{height:100px;flex-basis:100px;padding-top:0}
.design-panel:not(.final-choices) .choice{padding-top:5px;padding-bottom:5px;margin-bottom:5px}
.council-context .record-quote{padding:9px 0}
.final-design-left>.compact-map{height:345px}.final-design-left .map-visual{width:600px;height:343px}
.final-choices .choice{padding-top:7px;padding-bottom:7px}

/* Let the final-review introduction size naturally before the three cards. */
.review-summary .screen-heading{display:block;height:auto;margin-bottom:24px}

/* Guide the learner from the current evidence to the next unfinished record. */
.review-summary .screen-heading{margin-bottom:16px}
.review-intro{display:grid;grid-template-columns:minmax(0,1fr) 180px;align-items:center;gap:26px;padding:14px 18px;background:#e8edde;border:1px solid #c6d3b9;border-left:3px solid #6c9277;border-radius:3px;margin-bottom:24px}
.review-intro p{font-size:16px;line-height:1.45;color:#526b54}.review-intro .review-next{font-size:14px;line-height:1.45;margin-top:5px;color:#4c6b50}.review-intro.ready{background:#e2eddb;border-color:#a9c299}
.record-count{display:flex;flex-direction:column;align-items:center;border-left:1px solid #b9cbb0;line-height:1.3;color:var(--teal);padding-left:20px}.record-count strong{font-family:var(--serif);font-size:29px;font-weight:400}.record-count strong>span{font-size:20px;color:#74906a}.record-count>span{font-size:12px;margin-top:4px}
.review-summary .completion-grid{height:370px}.review-summary .completion-card{padding:20px;position:relative}.completion-card.active{border-color:var(--teal);box-shadow:inset 0 3px var(--teal);background:#f5f7ec}.completion-card.complete{border-color:#adbe9e}
.completion-card-top{display:flex;align-items:center;justify-content:space-between;gap:8px;min-height:19px}.completion-card-top .eyebrow{font-size:11px;letter-spacing:.07em}.record-state{display:inline-flex;gap:4px;align-items:center;font-size:11px;line-height:1.4;white-space:nowrap;letter-spacing:.04em;color:#8e7a58}.record-state.complete{color:#55794e;letter-spacing:0}.record-state .icon{width:14px;height:14px}.record-state.active{color:var(--teal);font-weight:600}
.review-summary .completion-card>h2{font-size:32px;margin:12px 0 14px}.summary-evidence{margin:0;display:flex;flex-direction:column;gap:11px}.summary-evidence>div{min-width:0}.summary-evidence dt{font-size:13px;line-height:1.4;color:#76896b;margin-bottom:4px}.summary-evidence dd{font-size:16px;line-height:1.4;margin:0;color:#4d6653;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden;overflow-wrap:anywhere}
.review-summary .completion-card>.completion-note{font-size:14px;line-height:1.45;margin:12px 0 14px;color:#876e46}.review-summary .completion-card>.completion-note.saved{color:#5f7d53}.completion-note>b{font-weight:600}.summary-questions{display:grid;grid-template-columns:1fr 1fr;gap:13px 15px;list-style:none;margin:4px 0 14px;padding:0}.summary-questions li{display:flex;gap:8px;align-items:baseline;font-size:16px;line-height:1.4;color:#7c866f}.summary-questions li>span{font-size:16px;flex-shrink:0}.summary-questions .checked{color:#4d7554}.review-summary .completion-card>.knowledge-note{font-size:15px;line-height:1.45;color:#718268;margin:0}.review-summary .process-check{margin-top:16px;gap:14px}
.report-rubric .chosen-result{margin-bottom:18px;padding-bottom:16px}.report-rubric>h2{font-size:30px;margin-bottom:13px}.reasoning-prompts{padding-left:23px;margin:0;color:#6c805f}.reasoning-prompts li{font-size:16px;line-height:1.4;margin-bottom:12px;padding-left:3px}.reasoning-prompts b{display:block;font-size:17px;color:#4e7054;font-weight:500}.reasoning-prompts span{display:block;font-size:15px;line-height:1.4;margin-top:4px}.report-rubric>.callout{margin-top:16px}

/* Override SugarCube's dark hover/focus form defaults inside the light game. */
#game-root textarea.review-text{color-scheme:light;background-color:#f3f4e7;color:var(--ink);-webkit-text-fill-color:var(--ink);caret-color:var(--teal);border-color:#b9c9ac}
#game-root textarea.review-text:focus{border-color:var(--teal);outline:2px solid #6a9990;outline-offset:2px}
#game-root textarea.review-text::placeholder{color:#7b8d70;-webkit-text-fill-color:#7b8d70;opacity:1}
#game-root textarea.review-text::selection{background:#c7d9bb;color:var(--ink)}
/* Keep camera captions inside the board with room below their last line. */
.camera-controls{height:auto;min-height:40px}
.time-sequence{height:auto;min-height:80px;align-items:flex-start;padding:0 12px 14px}
.time-sequence span{line-height:1.4}.time-sequence b{line-height:1.25;margin-bottom:5px}.time-sequence>i{margin-top:15px}
.evidence-reader .screen-heading{display:block;height:auto;margin-bottom:24px}.evidence-reader .reader-layout{height:528px}
.camera-reader .reader-art{display:flex;align-items:stretch}.camera-reader .reader-art>.camera-board{height:auto;max-height:none;flex:1 1 0}
/* Reserve room for two-line role excerpts and the working-mode label. */
.council-context .review-stages{margin:10px 0}.council-context .proposal-card{padding:10px 15px;margin-bottom:9px}.council-context .record-quote{padding:6px 0}.council-context .record-quote p{overflow-wrap:anywhere}.council-context .mode-label{margin-top:8px}


:: StoryScript [script]
/* Original, deliberately simplified teaching model. Units: m³ per 10-minute round. */
(function (root, factory) {
  const api = factory();
  if (typeof module === 'object' && module.exports) module.exports = api;
  else root.Hydro = api;
})(typeof window !== 'undefined' ? window : globalThis, function () {
  'use strict';
  const sum = a => a.reduce((s, n) => s + n, 0);
  const round = n => Math.round(n * 10) / 10;
  const scale = (a, k) => a.map(n => n * k);
  const shift = (a, n) => a.map((_, i) => i < n ? 0 : a[i - n]);
  const COST = {source: 8, old: 6, split: 4};
  const FINAL_COST = {none: 0, tanks: 4, timing: 0, field: 2};
  function runoff(rain, area, coefficient) { return rain / 1000 * area * coefficient; }
  function detained(a, capacity, start, rate) {
    let held = 0;
    return a.map((incoming, i) => {
      const take = Math.min(incoming, capacity - held);
      held += take;
      const release = i >= start ? Math.min(rate, held) : 0;
      held -= release;
      return incoming - take + release;
    });
  }
  function profiles(choices) {
    let plain = [12, 28, 32, 16, 4, 0, 0, 0, 0, 0];
    let hill = [0, 0, 24, 40, 32, 12, 0, 0, 0, 0];
    if (choices.baishi === 'permeable') plain = scale(plain, .65);
    if (choices.baishi === 'store') plain = detained(plain, 18, 4, 6);
    if (choices.baishi === 'inlet') plain = [28, 44, 16, 4, 0, 0, 0, 0, 0, 0];
    if (choices.placement !== 'offpath') {
      if (choices.qingling === 'intercept') hill = scale(hill, .6);
      if (choices.qingling === 'detain') hill = detained(hill, 30, 4, 10);
      if (choices.qingling === 'bypass') hill = [0, 24, 40, 32, 12, 0, 0, 0, 0, 0];
    }
    if (choices.confluence === 'source') hill = scale(hill, .55);
    return {plain, hill};
  }
  function canTime(choices) { return (choices.placement !== 'offpath' && ['intercept', 'detain'].includes(choices.qingling)) || choices.confluence === 'source'; }
  function finalAllowed(choices, flags, adjustment) {
    if (!(adjustment in FINAL_COST)) return false;
    if (12 - (COST[choices.confluence] || 0) < FINAL_COST[adjustment]) return false;
    if (adjustment === 'timing' && !canTime(choices)) return false;
    if (adjustment === 'field' && !(flags.fieldAgreement && flags.restorePromise)) return false;
    return true;
  }
  function simulate(choices = {}, adjustment = 'none', priority = 'balanced', water = 'high') {
    let {plain, hill} = profiles(choices);
    if (adjustment === 'timing' && canTime(choices)) hill = shift(hill, 2);
    const baseCaps = choices.confluence === 'old' ? [50, 12] : choices.confluence === 'split' ? [24, 24] : [18, 18];
    const caps = baseCaps.map(n => n + (adjustment === 'tanks' ? 20 : 0));
    const allocation = priority === 'old' ? [.78, .22] : priority === 'corridor' ? [.25, .75] : [.55, .45];
    const holding = [0, 0], overflow = [0, 0];
    let field = 0, drained = 0;
    const rows = plain.map((p, t) => {
      const h = hill[t], incoming = p + h;
      const outlet = water === 'low' ? 32 : 16;
      const capture = adjustment === 'field' ? Math.min(Math.max(0, incoming - 20), 64 - field) : 0;
      field += capture;
      const after = incoming - capture;
      let used = 0;
      const spills = [0, 0];
      [.55, .45].forEach((share, j) => {
        const load = holding[j] + after * share;
        const out = Math.min(load, outlet * allocation[j]);
        used += out;
        spills[j] = Math.max(0, load - out - caps[j]);
        overflow[j] += spills[j];
        holding[j] = Math.min(caps[j], load - out);
      });
      drained += used;
      return {minute: (t + 1) * 10, plain: p, hill: h, incoming, outlet, drained: used, oldHeld: holding[0], corridorHeld: holding[1], oldSpill: spills[0], corridorSpill: spills[1], field};
    });
    const total = sum(plain) + sum(hill);
    const firstSpill = rows.find(r => r.oldSpill + r.corridorSpill > .001);
    const pass = overflow.map(n => n <= 6 + 1e-8);
    const ending = pass[0] && pass[1] ? (adjustment === 'field' ? 'field' : 'both') : pass[0] ? 'old' : pass[1] ? 'corridor' : 'delay';
    return {rows, plain, hill, total, peak: Math.max(...rows.map(r => r.incoming)), holding, caps, overflow, drained, field, pass, ending, firstSpill: firstSpill ? firstSpill.minute : null,
      balanceError: total - drained - field - sum(holding) - sum(overflow), cost: COST[choices.confluence] || 0, finalCost: FINAL_COST[adjustment], budget: 12 - (COST[choices.confluence] || 0) - FINAL_COST[adjustment], water, adjustment, priority};
  }
  return {sum, round, runoff, profiles, simulate, canTime, finalAllowed, COST, FINAL_COST};
});

