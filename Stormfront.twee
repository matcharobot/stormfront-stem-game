 report:{title:'The condition in the old report',kind:'FINAL REVIEW / ENGINEERING RECORD',text:'The old acceptance test used low river level: 32 m³ outlet capacity per 10-minute round. Today’s high river level leaves only 16 m³. Keep the storm and design unchanged to isolate this difference.'}
 },
 endings:{
 both:{title:'Both lights return',label:'BOTH DISTRICTS OPEN',image:'both-open',person:'shopkeeper',quote:'Now we can explain where the water came from, where it waited, and how it finally left.',text:'Both districts meet the high-river-level drill target. Mrs. Chen puts the new record beside the old marks; Lin adds the outlet conditions to the case file.'},
 field:{title:'The pitch buys one night',label:'AGREEMENT / BOTH OPEN',image:'field-agreement',person:'manager',quote:'The pitch rests tonight so the streets can reopen. Tomorrow: drain, clean, inspect. And tell every player about the postponed match.',text:'Both districts pass, relying on temporary pitch storage. The recommendation includes the match delay and a funded restoration commitment.'},
 old:{title:'Old Street opens first',label:'PARTIAL OPENING / OLD STREET',image:'old-street-only',person:'shopkeeper',quote:'Thank you for protecting our street. Please also explain why Transit Walk must remain closed.',text:'Old Street meets the target; Transit Walk does not. You recommend partial opening, keep the transit barrier in place and schedule another review.'},
 corridor:{title:'One route stays connected',label:'PARTIAL OPENING / TRANSIT WALK',image:'corridor-only',person:'transport',quote:'The connection can reopen. The shopkeepers are still waiting. They need a clear plan for what happens next.',text:'Transit Walk meets the target, while Old Street stays closed. Restoring a route does not remove the remaining risk to the low district.'},
 delay:{title:'Back to the drawing board',label:'OPENING DELAYED / REVIEW AGAIN',image:'review-delayed',person:'engineer',quote:'A failed drill can be useful evidence. Find the first overflowing round, then change the design.',text:'Neither district meets the target. You delay opening and return upstream with a clearer diagnosis of timing, storage and the outlet bottleneck.'}
 }
};

/* Learning evidence is separate from the hydraulic outcome. */
(function(root,factory){
  const api=factory();
  if(typeof module==='object'&&module.exports)module.exports=api;
  else root.StormLearning=api;
})(typeof window!=='undefined'?window:globalThis,function(){
  'use strict';
  const questions=[
    {id:'control',q:'Which is a fair comparison of grass and asphalt?',options:['Same rain, area and duration; change only the surface.','Change the rain and the surface together.','Compare watermarks from two different storms.'],correct:0,why:'Holding rain, area and duration constant isolates the surface effect.'},
    {id:'travel',q:'A bypass clears the foothill sooner. What must you check next?',options:['Local drainage proves the whole catchment is safe.','Whether its peak overlaps another flow downstream.','Only whether the new channel is wider.'],correct:1,why:'Local relief can shift the timing and increase downstream peak overlap.'},
    {id:'storage',q:'What does water in a tank at minute 100 represent?',options:['Water removed from the water cycle.','Water already discharged into the river.','Water still stored, needing a later drainage plan.'],correct:2,why:'Storage changes timing. The retained volume remains in the water balance.'},
    {id:'transfer',q:'A different city floods after expanding its pipes. What is the best review?',options:['Check upstream runoff, arrival timing and downstream water level.','Judge safety from pipe diameter alone.','Copy this design without checking local conditions.'],correct:0,why:'A system explanation connects inflow, timing, storage and the outlet boundary.'}
  ];
  function words(text){return String(text||'').trim().split(/\s+/).filter(Boolean).length;}
  function upgrade(r){
    const legacy=r.version!==3;
    r.version=3;r.quiz=r.quiz||{};r.answers=r.answers||{};
    r.quizAttempts=r.quizAttempts||{};r.quizFirst=r.quizFirst||{};
    r.council=Object.assign({step:0,mode:'',proposal:'',metric:'',challenge:'',agreement:'',approvedFor:null},r.council||{});
    r.reviewStep=r.reviewStep||'quiz';r.followup=r.followup||'';
    r.reportMetric=r.reportMetric||'';r.reportAcceptedFor=r.reportAcceptedFor||null;
    r.learningClosedFor=r.learningClosedFor||null;r.reportPage=r.reportPage||0;
    if(legacy){r.reviewStep='summary';r.quizIndex=firstMissingQuestion(r);}
    return r;
  }
  function designKey(r){const c=r.choices||{};return JSON.stringify([c.baishi,c.qingling,c.placement,c.confluence]);}
  function testKey(r){const s=r.sim;if(!s||s.water!=='high'||r.simChapter!=='review')return null;return JSON.stringify([designKey(r),r.adjustment,r.priority,s.total,s.overflow,s.holding,s.field]);}
  function explanationCorrect(r,key){return (r.answers||{})[key]===(key==='baishi'?'surface':'travel');}
  function score(r){return questions.filter(q=>(r.quiz||{})[q.id]===q.correct).length;}
  function quizComplete(r){return score(r)===questions.length;}
  function firstMissingQuestion(r){const i=questions.findIndex(q=>(r.quiz||{})[q.id]!==q.correct);return i<0?0:i;}
  function councilStepReady(r,step){const c=r.council||{};
    if(step===0)return ['pair','solo'].includes(c.mode)&&words(c.proposal)>=8;
    if(step===1)return ['peak','budget','overflow'].includes(c.metric)&&words(c.challenge)>=8;
    return words(c.agreement)>=6;
  }
  function councilDraftReady(r){return [0,1,2].every(i=>councilStepReady(r,i));}
  function councilComplete(r){return !!r.choices?.confluence&&councilDraftReady(r)&&r.council.approvedFor===designKey(r);}
  function reportChecks(r){return {
    simulation:!!testKey(r),
    path:(r.answers||{}).path==='connected',
    metric:['inflow','old','walk','held'].includes(r.reportMetric),
    explanation:words(r.explanation)>=12,
    followup:words(r.followup)>=6
  };}
  function reportDraftReady(r){return Object.values(reportChecks(r)).every(Boolean);}
  function reportComplete(r){const key=testKey(r);return !!key&&reportDraftReady(r)&&r.reportAcceptedFor===key;}
  function canComplete(r){return !!testKey(r)&&explanationCorrect(r,'baishi')&&explanationCorrect(r,'qingling')&&quizComplete(r)&&councilComplete(r)&&reportComplete(r);}
  function caseClosed(r){return canComplete(r)&&r.learningClosedFor===testKey(r);}
  function nextCouncilStep(r){return !councilStepReady(r,0)?0:!councilStepReady(r,1)?1:2;}
  function reviewGuide(r){
    const c=r.council||{},checks=reportChecks(r),complete={council:councilComplete(r),quiz:quizComplete(r),report:reportComplete(r)};
    const councilNeed=complete.council?'Reason, evidence challenge and joint response saved.':
      !['pair','solo'].includes(c.mode)?'Choose paired review or solo self-review.':
      words(c.proposal)<8?'Explain the reason for your design.':
      !['peak','budget','overflow'].includes(c.metric)?'Select a datum for the evidence check.':
      words(c.challenge)<8?'Record the evidence checker’s question.':
      words(c.agreement)<6?'Record the agreed response and next action.':'Confirm the review for your current design.';
    const reportNeed=complete.report?'Path, datum, explanation and follow-up recorded.':
      !checks.simulation?'Run the current high-river test first.':
      !checks.path?'Connect the upstream and downstream flow path.':
      !checks.metric?'Attach a value from your current test.':
      !checks.explanation?'Explain how a design decision produced this result.':
      !checks.followup?'Explain a cost, remaining risk or follow-up responsibility.':'Record the statement for your current test.';
    let next;
    if(!checks.simulation)next={key:'test',action:'return-test',label:'Continue: Run the storm test',hint:'A current high-river test is needed before you can close the case.'};
    else if(!explanationCorrect(r,'baishi'))next={key:'surface',action:'recheck-explanation',id:'baishi',label:'Continue: Recheck surfaces',hint:'Use the controlled experiment to revise your surface explanation.'};
    else if(!explanationCorrect(r,'qingling'))next={key:'travel',action:'recheck-explanation',id:'qingling',label:'Continue: Recheck travel time',hint:'Use the camera record to revise your travel-time explanation.'};
    else if(!complete.council)next={key:'council',action:'review-council',label:'Continue: Complete the role review',hint:councilNeed};
    else if(!complete.quiz)next={key:'quiz',action:'open-quiz',label:'Continue: Check your understanding',hint:'Revisit the next unsupported response and use its feedback.'};
    else if(!complete.report)next={key:'report',action:'continue-report',label:'Continue: Complete the statement',hint:reportNeed};
    else next={key:'close',action:'complete-case',label:'Close the case & reveal the ending',hint:'All learning records are complete. You can now reveal your engineering ending.'};
    return {complete,count:Object.values(complete).filter(Boolean).length,councilNeed,reportNeed,next};
  }
  return {questions,words,upgrade,designKey,testKey,explanationCorrect,score,quizComplete,firstMissingQuestion,councilStepReady,councilDraftReady,councilComplete,reportChecks,reportDraftReady,reportComplete,canComplete,caseClosed,nextCouncilStep,reviewGuide};
});

(function(){
'use strict';
const D=window.StormData,H=window.Hydro,L=window.StormLearning,KEY='stormfront-english-16x9-v2';
const chapters=D.chapters,pages=['Briefing','Baishi','Qingling','Confluence','Review','Debrief','Ending'];
let sound=null,timer=null,boot=true,storageOK=true;
Config.history.maxStates=1;Config.passages.transitionOut=0;Config.saves.maxAutoSaves=0;
function fresh(){return L.upgrade({version:3,checkpoint:'Briefing',begun:false,choices:{},flags:{},evidence:[],first:{},phase:{},node:{},answers:{},lab:{rain:30,done:false},sim:null,simChapter:null,reviewMethod:null,adjustment:'none',priority:'balanced',explanation:'',quiz:{},quizIndex:0,endPage:'ending',aboutIndex:0,journalIndex:0,dossier:null,frame:1,audio:false,returnTo:'Start',compare:false});}
let loaded;try{loaded=JSON.parse(localStorage.getItem(KEY));}catch(_){storageOK=false;}if(!loaded||![2,3].includes(loaded.version))loaded=fresh();else loaded=L.upgrade(loaded);
const clone=x=>JSON.parse(JSON.stringify(x));
function R(){let r=State.variables.run;if(!r)r=State.variables.run=clone(loaded);if(r.version!==3||!r.council)L.upgrade(r);return r;}
function save(){try{localStorage.setItem(KEY,JSON.stringify(R()));}catch(_){storageOK=false;}}
const e=v=>String(v==null?'':v).replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
const n=H.round;
function image(path,alt,cls=''){const src=window.StormAssetMap&&window.StormAssetMap[path]||'assets/'+path+'.webp';return `<img src="${src}" alt="${e(alt)}" class="${cls}" draggable="false">`;}
function icon(name){const d={arrow:'<path d="M4 12h15m-6-6 6 6-6 6"/>',back:'<path d="M20 12H5m6-6-6 6 6 6"/>',drop:'<path d="M12 3C9 7 5 11 5 15a7 7 0 0 0 14 0c0-4-4-8-7-12Z"/><path d="M8 15a4 4 0 0 0 4 4"/>',book:'<path d="M4 4h7a4 4 0 0 1 4 4v13a4 4 0 0 0-4-3H4Zm16 0h-5v14h5Z"/>',sound:'<path d="m4 9 4 0 5-4v14l-5-4H4Zm13-2a7 7 0 0 1 0 10"/>',check:'<path d="m5 12 4 4L20 5"/>',close:'<path d="m6 6 12 12M18 6 6 18"/>',download:'<path d="M12 3v12m-4-4 4 4 4-4M4 16v5h16v-5"/>'};return `<svg viewBox="0 0 24 24" class="icon" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">${d[name]||d.arrow}</svg>`;}
function btn(text,action,cls='btn',attrs=''){return `<button class="${cls}" data-action="${action}" ${attrs}>${text}</button>`;}
const tag=(t,c='')=>`<span class="tag ${c}">${t}</span>`;
function go(page){R().dossier=null;save();Engine.play(page);}
function C(){return chapters.find(c=>c.id===State.passage);}
function phase(c){return R().phase[c.key]||'survey';}
function setPhase(p){R().phase[C().key]=p;R().compare=false;save();render();}
function addEvidence(id){if(!R().evidence.includes(id))R().evidence.push(id);}
function invalidate(){const r=R();r.sim=null;r.simChapter=null;r.reportMetric='';r.reportAcceptedFor=null;r.learningClosedFor=null;}
function fit(){document.documentElement.style.setProperty('--scale',Math.min(innerWidth/1440,innerHeight/810));}
function toast(text){const t=document.getElementById('toast');if(t){t.textContent=text;t.classList.add('show');setTimeout(()=>t.classList.remove('show'),2600);}}
function top(){const r=R();return `<nav class="scene-tools" aria-label="In-scene tools"><span class="save-status"><i></i>${storageOK?'SAVED ON THIS DEVICE':'SAVING UNAVAILABLE'}</span>${State.passage==='Start'?'':btn('Home','home','nav-btn')}${btn(icon('book')+'Field journal <b>'+r.evidence.length+'</b>','journal','nav-btn')}${btn(icon('sound')+'Rain '+(r.audio?'on':'off'),'sound','nav-btn',`aria-pressed="${r.audio}"`)}${btn('About the course','about','nav-btn')}</nav>`;}
function bottom(left='',right=''){return left||right?`<nav class="scene-actions" aria-label="Scene navigation"><div>${left}</div><div>${right}</div></nav>`:'';}
function portrait(key,quote,cls=''){const p=D.people[key];return `<div class="dialogue ${cls}">${image('portraits/'+p.image,p.name+', '+p.role)}<div><b>${p.name}</b><small>${p.role}</small><p>“${quote}”</p></div></div>`;}
function heading(kicker,title,sub=''){return `<div class="screen-heading"><div><span class="eyebrow">${kicker}</span><h1>${title}</h1>${sub?'<p>'+sub+'</p>':''}</div></div>`;}
function route(c){return `<div class="routebar">${chapters.map((q,i)=>`<span class="${q===c?'current':i<chapters.indexOf(c)?'done':''}"><b>${i<chapters.indexOf(c)?'✓':q.no}</b>${q.city}${i<3?'<i></i>':''}</span>`).join('')}<small>${c.terrain}</small></div>`;}
function frame(body,foot,cls=''){return `<div class="game-stage ${cls}">${top()}<main class="game-main" id="main" tabindex="-1">${body}</main>${foot}<div class="toast" id="toast" role="status" aria-live="polite"></div><dialog id="reset-dialog" aria-labelledby="reset-title"><span class="eyebrow">NEW INVESTIGATION</span><h2 id="reset-title">Start a fresh case?</h2><p>This replaces this browser’s current progress. You can export a report from your ending first.</p><div class="button-row">${btn('Keep my progress','cancel-reset','btn secondary')}${btn('Start again','confirm-reset')}</div></dialog></div>`;}
function home(){const r=R();return frame(`<section class="cover"><div class="cover-art">${image('cover/cover','A flat plain, wooded slopes and a river city in one catchment')}</div><div class="cover-copy"><h1>STORM<br>FRONT<span>The Three-City Drainage Case</span></h1><p class="cover-question">The pipe got bigger.<br>Why did the watermark rise?</p><p class="cover-description">${D.description}</p><div class="button-row">${btn((r.begun?'Continue the case':'Accept the case')+icon('arrow'),r.begun?'resume':'begin','btn large')}${r.begun?btn('Start a new case','reset','text-btn'):btn('About this course','about','text-btn')}</div></div><div class="cover-stamp"><span>JOINT STORM DRILL</span><strong>48<small>h</small></strong><span>FOLLOW THE WATER</span></div><div class="cover-route"><span>01 / BAISHI · SURFACES</span><span>02 / QINGLING · SLOPES</span><span>03—04 / HUIWAN · SYSTEMS</span><b>N ↗</b></div></section>`,bottom(),'home-screen');}
function briefing(){const r=R();return frame(`${heading('PROLOGUE / HUIWAN OLD STREET','One wall. Two watermarks.','The drainage upgrade passed its test. The street flooded again.')}<div class="brief-layout"><div class="brief-left"><figure class="case-photo">${image('evidence/old-town-watermarks','Two brown watermarks on the same tiled wall')}<span class="photo-label upper">AFTER EXPANSION · HIGHER MARK</span><span class="photo-label lower">BEFORE EXPANSION · LOWER MARK</span><figcaption>EVIDENCE 001 / TWO DIFFERENT STORM EVENTS</figcaption></figure>${portrait('shopkeeper','Don’t just tell me how wide the pipe is. Tell me whether these streets can open next time.')}</div><div class="brief-right"><p>Mrs. Chen brings a flood photograph. Engineer Lin brings a passing test report. Both are genuine. What changed?</p><div class="callout">You are the catchment investigator. Visit Baishi and Qingling, then return to Huiwan with a tested design.</div><span class="eyebrow">RECORD A FIRST HYPOTHESIS / NO PENALTY</span>${[['surface','The upstream surface changed.','More rainfall became runoff.'],['timing','Two peaks arrived together.','Timing overloaded the junction.'],['outlet','The outlet became constrained.','A bigger pipe could not discharge.']].map(([id,t,d])=>`<button class="hypothesis ${r.answers.hypothesis===id?'selected':''}" data-action="hypothesis" data-id="${id}" aria-pressed="${r.answers.hypothesis===id}"><b>${t}</b><span>${d}</span></button>`).join('')}<p class="hint">Follow clues → experiment → explain → design → test.<br>Your decisions persist across cities. All data are fictional teaching scenarios.</p></div></div>`,bottom(btn(icon('back')+'Title screen','home','btn secondary'),btn('Travel to Baishi'+icon('arrow'),'start','btn',r.answers.hypothesis?'':'disabled'),'PROLOGUE / A QUESTION TO INVESTIGATE'));}
function facility(c){const r=R(),k=c.key,v=r.choices[k];let items=[];if(k==='baishi'&&v)items=[[v==='permeable'?39:72,v==='permeable'?45:80,v==='permeable'?'PERMEABLE SURFACE':v==='store'?'18 m³ STORAGE':'WIDER INLET']];if(k==='qingling'&&v&&r.choices.placement)items=[[r.choices.placement==='onpath'?37:72,61,r.choices.placement==='offpath'?'OFF THE FLOW PATH':v==='detain'?'30 m³ STORAGE':v==='intercept'?'INTERCEPT + INFILTRATE':'FASTER BYPASS']];if((k==='confluence'||k==='review')&&r.choices.confluence){const v=r.choices.confluence;if(k==='confluence')items=v==='source'?[[22,33,'UPSTREAM INTERCEPTION']]:v==='old'?[[63,77,'OLD ST. 50 m³']]:[[54,67,'24 m³'],[70,87,'24 m³']];else{const s=H.simulate(r.choices,r.adjustment,r.priority);items=[[29,78,'OLD ST. '+s.caps[0]+' m³'],[62,49,'WALK '+s.caps[1]+' m³']];}}return items.map(([x,y,t])=>`<span class="facility" style="left:${x}%;top:${y}%">${t}</span>`).join('');}
function map(c,placement=false){const r=R(),node=c.nodes.find(x=>x.id===r.node[c.key]);return `<section class="map-panel"><div class="map-top"><span>${icon('drop')} CATCHMENT FIELD MAP</span><span>N ↑</span></div><div class="map-view"><div class="map-visual">${image('maps/'+c.image,c.city+' illustrated field map')}<svg class="flow-overlay" viewBox="0 0 1000 1000" preserveAspectRatio="none" aria-hidden="true"><defs><marker id="flow-arrow" markerWidth="7" markerHeight="7" refX="6" refY="3.5" orient="auto"><path d="M0 0 7 3.5 0 7Z" fill="#357f87"/></marker></defs>${c.paths.map(p=>`<path d="${p}" class="flow-path" marker-end="url(#flow-arrow)"/>`).join('')}</svg>${c.nodes.map((x,i)=>`<button class="map-node ${node===x?'selected':''}" style="left:${x.x}%;top:${x.y}%" data-action="node" data-id="${x.id}" aria-label="${x.label}"><b>${i+1}</b><span>${x.label}</span></button>`).join('')}${facility(c)}<span class="map-scale">FUNCTIONAL OVERLAY / NOT TO SCALE</span></div></div><div class="map-note">${placement?`<span><b>Choose the facility location</b>It must meet the actual water route.</span><div class="placement-options">${btn('On the main gully','placement','chip '+(r.choices.placement==='onpath'?'selected':''),'data-id="onpath"')}${btn('Convenient empty ground','placement','chip '+(r.choices.placement==='offpath'?'selected':''),'data-id="offpath"')}</div>`:`<b>${node?node.label:'Click a numbered location'}</b><span>${node?node.desc:'Trace the dashed connections. Examine a location, then choose a record or interview to investigate.'}</span>`}</div></section>`;}
function choice(o,selected,action='select',disabled=false,reason=''){return `<button data-action="${action}" data-id="${o.id}" class="choice ${selected?'selected':''}" aria-pressed="${!!selected}" ${disabled?'disabled':''}><span class="choice-top"><span>${selected?'●':'○'} ${o.tag}</span><b>${o.cost===0?'NO NEW COST':o.cost+' CR'}</b></span><strong>${o.title}</strong><small>${o.sub}</small><p>${reason||o.detail}</p></button>`;}
function missionShell(c,content,left,right,label){return frame(`<div class="mission-screen">${route(c)}${heading(c.time,c.no+' / '+c.title,c.question)}<div class="workspace ${phase(c)==='council'?'council-workspace':''}">${content}</div></div>`,bottom(left,right,c.city.toUpperCase()+' / '+label));}
function survey(c){const r=R();if(c.key==='review')return reviewSurvey(c);const visited=c.clues.some(id=>r.evidence.includes(id));const first=r.first[c.key];return missionShell(c,`${map(c)}<aside class="case-panel"><span class="eyebrow">SURVEY / CHOOSE YOUR FIRST LEAD</span><h2>${c.key==='confluence'?'Engineering has neighbours.':'Ask the evidence.'}</h2><p>${c.key==='confluence'?'You may meet all three groups. Their priorities differ; pitch access needs an agreement.':'Each record answers a different question. Open it, inspect it, then return to the map.'}</p><div class="clue-list">${c.clues.map((id,i)=>btn(`<span class="clue-no">0${i+1}</span><span><b>${D.evidence[id].title}</b><small>${r.evidence.includes(id)?'IN JOURNAL / REOPEN':'OPEN RECORD'}</small></span>${icon(r.evidence.includes(id)?'check':'arrow')}`,'clue','clue',`data-id="${id}"`)).join('')}</div>${first?`<div class="first-lead"><span class="eyebrow">FIRST LEAD RECORDED</span><p>${c.key==='confluence'?({merchants:'You heard the merchants first. The transport team asks: who protects the other route?',transport:'You heard transport first. The shopkeepers ask: will the low street be left behind?',field:'You heard the pitch manager first. Both street groups ask for a funded restoration promise.'}[first]):D.evidence[first].title}</p></div>`:'<div class="first-lead"><span class="eyebrow">TEAM NOTE</span><p>In pairs, one person proposes a design and the other checks the evidence. Swap roles in the next city.</p></div>'}</aside>`,btn(icon('back')+'Case notes','journal','btn secondary'),btn((c.key==='baishi'?'Run a controlled experiment':c.key==='qingling'?'Explain the delayed flow':'Choose a shared design')+icon('arrow'),'next-survey','btn',visited?'':'disabled'),'SURVEY');}
function labVisual(){const r=R(),a=n(H.runoff(r.lab.rain,1000,.9)),b=n(H.runoff(r.lab.rain,1000,.25));return `<div class="lab-board"><div class="lab-context"><span>CONTROLLED COMPARISON</span><span>1,000 m² EACH / 30 MINUTES EACH</span></div><div class="surface-pair"><div class="surface asphalt"><span>ASPHALT</span><div class="water-fill" style="--level:${r.lab.done?a/45*100:0}%"></div><strong>${r.lab.done?a:'—'}<small>m³ runoff</small></strong><span class="coefficient">C = 0.90 / 90% becomes runoff</span></div><div class="surface lawn"><span>GRASS</span><div class="water-fill" style="--level:${r.lab.done?b/45*100:0}%"></div><strong>${r.lab.done?b:'—'}<small>m³ runoff</small></strong><span class="coefficient">C = 0.25 / 25% becomes runoff</span></div></div><div class="lab-formula"><b>V = rainfall ÷ 1000 × area × runoff coefficient</b><p>${r.lab.done?`${r.lab.rain} ÷ 1000 × 1,000 × 0.90 = ${a} m³; grass gives ${b} m³.`:'Generate the runoff data before drawing a conclusion.'}</p></div><p class="hint">This small test is separate from the fictional whole-district flow profiles. Real runoff also depends on soil wetness and rainfall intensity.</p></div>`;}
function lab(c){const r=R();return missionShell(c,`${labVisual()}<aside class="case-panel lab-sidebar"><span class="eyebrow">EXPLORE / CHANGE ONE VARIABLE</span><h2>Same rain. Different surfaces.</h2><p>Keep area and duration identical. Apply the same rainfall to both samples.</p><label class="field-label">Rainfall for both samples</label><div class="segmented">${[20,30,45].map(v=>btn(v+' mm','rain','chip '+(r.lab.rain===v?'selected':''),`data-id="${v}" aria-pressed="${r.lab.rain===v}"`)).join('')}</div>${btn((r.lab.done?'Repeat the experiment':'Run the experiment')+icon('arrow'),'lab','btn full')}<div class="callout"><b>Before running:</b> predict the larger runoff. Run, then change the rainfall and test again.</div></aside>`,btn(icon('back')+'Return to evidence','back-survey','btn secondary'),btn('Explain the result'+icon('arrow'),'explain','btn',r.lab.done?'':'disabled'),'CONTROLLED EXPERIMENT');}
function camera(){const r=R();return `<div class="camera-board"><div class="camera-image">${image('evidence/qingling-camera','Illustrated foothill camera record')}<svg class="camera-overlay" viewBox="0 0 1000 570" aria-hidden="true"><path d="M140 150 Q360 300 680 450" class="flow-path"/><ellipse cx="710" cy="440" rx="${r.frame===1?85:170}" ry="${r.frame===1?25:54}" class="ponding"/></svg><span class="timestamp">CAM-02 / 14:${r.frame===1?'20':'30'}:00</span></div><div class="camera-controls">${btn('14:20 / arriving','camera-frame','chip '+(r.frame===1?'selected':''),'data-id="1"')}${btn('14:30 / rising','camera-frame','chip '+(r.frame===2?'selected':''),'data-id="2"')}</div><div class="time-sequence"><span><b>14:10</b>Rain stops uphill</span><i>→</i><span><b>14:20</b>Water reaches foothill</span><i>→</i><span><b>14:30</b>Tributary receives flow</span></div></div>`;}
function explain(c){const r=R(),b=c.key==='baishi',answer=r.answers[c.key],correct=b?'surface':'travel';const options=b?[['surface','Different surfaces change the proportion that becomes runoff.'],['area','The asphalt sample must cover a larger area.'],['rain','More rain fell on the asphalt sample.']]:[['travel','Runoff already generated keeps travelling downhill after rain stops.'],['stop','The water must mean it is still raining at the ridge.']];return missionShell(c,`${b?labVisual():camera()}<aside class="case-panel explain-sidebar"><span class="eyebrow">EXPLAIN / USE YOUR OBSERVATIONS</span><h2>${b?'What explains the difference?':'Does rain stopping mean inflow stops?'}</h2><div class="answer-list">${options.map(([id,t])=>btn(t,'explanation-choice','answer '+(answer===id?'selected':''),`data-id="${id}"`)).join('')}</div>${answer?`<div class="feedback ${answer===correct?'good':'revise'}"><b>${answer===correct?'Supported by the evidence.':'Recheck the evidence.'}</b><p>${b?'The rain, area and duration were identical. Surface type was the changed variable.':'The tracer and camera records show travel time from the ridge to the junction.'}</p></div>`:'<div class="callout">Choose an explanation. Feedback will identify which observation supports or challenges it.</div>'}</aside>`,(r.explanationReturn?btn(icon('back')+'Review checklist','review-summary','btn secondary'):btn(icon('back')+(b?'Back to experiment':'Back to survey'),b?'back-lab':'back-survey','btn secondary')),btn((r.explanationReturn?'Return to learning review':'Design a response')+icon('arrow'),'design','btn',L.explanationCorrect(r,c.key)?'':'disabled'),'EXPLANATION');}
function design(c){const r=R();if(c.key==='review')return finalDesign(c);const budget=c.key==='baishi'?3:c.key==='qingling'?4:12;return missionShell(c,`${map(c,c.key==='qingling')}<aside class="case-panel design-panel"><div class="budget"><span>${c.key==='confluence'?'SHARED CITY BUDGET':'LOCAL PILOT BUDGET'}</span><b>${budget}<small> CR</small></b></div>${c.options.map(o=>choice(o,r.choices[c.key]===o.id)).join('')}<p class="hint">${c.key==='confluence'?'Unspent shared credits and upstream flows carry into the final chapter.':'Pilot funds are separate. Your water volume and timing carry downstream.'}</p></aside>`,btn(icon('back')+'Review the evidence','back-survey','btn secondary'),btn('Run the storm test'+icon('arrow'),'simulate','btn',r.choices[c.key]&&(c.key!=='qingling'||r.choices.placement)?'':'disabled'),'ENGINEERING DESIGN');}
function chart(s,water=s.water){const max=Math.max(100,s.peak+10),bottom=176,h=145,left=44,x=i=>left+29+i*58,y=v=>bottom-v/max*h;return `<div class="hydrograph"><div class="chart-label"><b>INFLOW / 10-MINUTE ROUNDS</b><span><i class="plain-key"></i>Plain <i class="hill-key"></i>Hill <i class="outlet-key"></i>Outlet limit</span></div><svg viewBox="0 0 670 215" role="img" aria-label="Ten-round inflow chart; peak ${n(s.peak)} cubic metres; outlet limit ${water==='low'?32:16} cubic metres per round"><text x="5" y="18">m³</text>${[0,25,50,75,100].map(v=>`<line x1="${left}" x2="648" y1="${y(v)}" y2="${y(v)}" class="grid-line"/><text x="${left-8}" y="${y(v)+4}" text-anchor="end">${v}</text>`).join('')}${s.rows.map((a,i)=>`<rect class="plain-bar" x="${x(i)-15}" width="30" y="${y(a.plain)}" height="${a.plain/max*h}"/><rect class="hill-bar" x="${x(i)-15}" width="30" y="${y(a.incoming)}" height="${a.hill/max*h}"/><text x="${x(i)}" y="196" text-anchor="middle">${a.minute}</text>`).join('')}<line x1="${left}" x2="648" y1="${y(water==='low'?32:16)}" y2="${y(water==='low'?32:16)}" class="outlet-line"/><text x="648" y="213" text-anchor="end">minutes →</text></svg></div>`;}
function regions(s){return `<div class="region-pair">${['Old Street','Transit Walk'].map((t,i)=>`<div class="region ${s.pass[i]?'pass':'fail'}"><span>${t}</span><strong>${n(s.overflow[i])}<small>m³ overflow</small></strong><b>${s.pass[i]?'✓ Meets drill target':'! Exceeds drill target'}</b><small>Cumulative target ≤ 6 m³</small></div>`).join('')}</div>`;}
function localConsequence(c){const r=R();if(c.key==='baishi')return {permeable:'Some rain no longer enters the drainage network as surface runoff.',store:'Storage moves water in time. It does not make that water disappear.',inlet:'Local drainage is faster. The next city receives the same water sooner.'}[r.choices.baishi];if(c.key==='qingling')return r.choices.placement==='offpath'?'Water bypasses your facility. It is large enough, but it is not on the connected flow route.':{intercept:'Interception works because it meets the main gully before water reaches the foothill.',detain:'The peak moves later. Compare this new arrival time with Baishi’s contribution.',bypass:'The foothill gets relief, but the tributary receives the water one round earlier.'}[r.choices.qingling];return 'A pass depends on the combined inflow and the outlet condition, not two separate tributary records.';}
function trial(c){const r=R(),s=r.sim;if(c.key==='review')return finalTrial(c);const o=c.options.find(o=>o.id===r.choices[c.key]),profile=c.key==='baishi'?s.plain:s.hill;return missionShell(c,`<section class="result-board"><div class="board-header"><span class="eyebrow">${c.key==='confluence'?'OLD REPORT / LOW RIVER LEVEL':'DISTRICT FLOW / DOWNSTREAM PREVIEW'}</span>${tag('OUTLET: 32 m³ / ROUND')}</div>${c.key==='confluence'?regions(s):`<div class="metric-row"><div><span>Sent downstream</span><strong>${n(H.sum(profile))}<small>m³</small></strong></div><div><span>Peak arrival</span><strong>${(profile.indexOf(Math.max(...profile))+1)*10}<small>min</small></strong></div><div><span>Peak per round</span><strong>${n(Math.max(...profile))}<small>m³</small></strong></div></div>`}${chart(s,'low')}<div class="feedback ${c.key==='qingling'&&r.choices.placement==='offpath'?'revise':'neutral'}">${localConsequence(c)}</div><p class="hint">${c.key==='confluence'?'Compare the two districts, not just the total. Opening targets are fictional classroom indicators.':'Plain and hill profiles share one time axis. The other city is shown as a reference until you make its choice.'}</p></section><aside class="case-panel"><span class="eyebrow">YOUR CURRENT RESPONSE</span><h2>${o.sub}</h2><p>${o.detail}</p>${portrait(c.person,localConsequence(c),'vertical')}<div class="callout">${c.key==='confluence'?`You spent ${s.cost} credits. ${12-s.cost} remain. New information: the river is higher than it was during the old test.`:c.key==='baishi'?'Carry this question: does faster drainage here mean safer conditions downstream?':'Carry this question: will the two inflow peaks meet at the same time?'}</div></aside>`,btn(icon('back')+'Revise & retest','design','btn secondary'),btn((c.key==='baishi'?'Travel to Qingling':c.key==='qingling'?'Travel to Huiwan':'Review this proposal')+icon('arrow'),'commit','btn'),'STORM TEST');}
function reviewSurvey(c){const r=R(),s=H.simulate(r.choices),methods=[['conditions','Compare the test conditions','Check the old outlet limit against today’s river level.'],['time','Replay the combined inflows','Locate the round when the two contributions overlap.'],['location','Test the current layout first','Find which district overflows first.']];const method=r.reviewMethod;return missionShell(c,`<section class="review-board">${method==='conditions'?`<span class="eyebrow">ONE CHANGED CONDITION</span><h2>The report and the photograph can both be right.</h2><div class="outlet-pair"><div><span>OLD TEST / LOW RIVER</span><strong>32<small>m³ per round</small></strong></div><div><span>TODAY / HIGH RIVER</span><strong>16<small>m³ per round</small></strong></div></div><p>Higher downstream water reduces the driving head at the outlet. Our teaching model halves its capacity, keeping the storm and design unchanged.</p>${portrait('engineer',c.quote)}`:method?`<span class="eyebrow">${method==='time'?'FIND THE OVERLAP':'FIND THE FIRST OVERFLOW'}</span>${chart(s)}<div class="callout">${method==='time'?`Peak inflow: ${n(s.peak)} m³ in one round. The outlet can discharge only 16 m³ per round.`:s.firstSpill?`The current layout first overflows at minute ${s.firstSpill}. Old Street: ${n(s.overflow[0])} m³; Transit Walk: ${n(s.overflow[1])} m³.`:'The current layout produces no overflow. Check whether that remains true after any new adjustment.'}</div>${portrait('engineer',c.quote)}`:map(c)}</section><aside class="case-panel"><span class="eyebrow">REVIEW / CHOOSE A DIAGNOSTIC ROUTE</span><h2>Same system.<br>A different boundary.</h2>${methods.map(([id,t,d])=>`<button class="review-choice ${method===id?'selected':''}" data-action="review-method" data-id="${id}"><b>${t}</b><span>${d}</span></button>`).join('')}<p class="hint">All three routes remain available. They reveal the bottleneck through conditions, time or location.</p>${method?btn('Open the original report','record-report','text-btn'):''}</aside>`,btn(icon('back')+'Field journal','journal','btn secondary'),btn('Make the final adjustment'+icon('arrow'),'design','btn',method?'':'disabled'),'OUTLET REVIEW');}
function finalOptions(){return [{id:'none',title:'Test the existing system',sub:'Keep present capacity',cost:0,tag:'RETAIN FUNDS',detail:'Keep existing tanks; adjust the district outlet allocation if needed.'},{id:'tanks',title:'Add storage to both districts',sub:'+20 m³ in each district',cost:4,tag:'ADD CAPACITY',detail:'Add 20 m³ in each district for 4 credits. Drain stored water after the drill.'},{id:'timing',title:'Separate the two peaks',sub:'Delay hill flow by 20 minutes',cost:0,tag:'CHANGE TIMING',detail:'Delay hill inflow by 20 minutes using upstream controls. Total volume stays unchanged.'},{id:'field',title:'Activate the community pitch',sub:'Up to 64 m³ temporary storage',cost:2,tag:'HONOUR THE AGREEMENT',detail:'Store up to 64 m³ of inflow above 20 m³ per round. Spend 2 credits on restoration.'}];}
function finalDesign(c){const r=R(),budget=12-H.COST[r.choices.confluence];return missionShell(c,`<div class="final-design-left"><div class="compact-map">${map(c)}</div><div class="final-controls"><div class="restore"><label><input type="checkbox" id="restore" ${r.flags.restorePromise?'checked':''} ${r.flags.fieldAgreement?'':'disabled'}><span><b>Commit to pitch restoration</b>Postpone the match; drain, clean and inspect before reopening.${r.flags.fieldAgreement?'':' Agreement not obtained at the fringe.'}</span></label></div><div><span class="eyebrow">ALLOCATE THE 16 m³ / ROUND OUTLET</span><div class="priority-options">${[['balanced','Balanced / 55:45'],['old','Old Street / 78:22'],['corridor','Transit / 25:75']].map(([id,t])=>btn(t,'priority','chip '+(r.priority===id?'selected':''),`data-id="${id}" aria-pressed="${r.priority===id}"`)).join('')}</div><p class="hint">Independent branches: unused outlet share is not borrowed automatically.</p></div></div></div><aside class="case-panel design-panel final-choices"><div class="budget"><span>REMAINING SHARED FUNDS</span><b>${budget}<small> CR</small></b></div>${finalOptions().map(o=>{const valid=H.finalAllowed(r.choices,r.flags,o.id);let reason=o.id==='field'&&!r.flags.fieldAgreement?'Locked: visit the pitch manager at the fringe.':o.id==='field'&&!r.flags.restorePromise?'Locked: confirm the restoration commitment.':o.id==='timing'&&!H.canTime(r.choices)?'Locked: no effective upstream control.':'';return choice(o,r.adjustment===o.id,'adjustment',!valid,reason);}).join('')}</aside>`,btn(icon('back')+'Recheck the diagnosis','back-survey','btn secondary'),btn('Retest at high river level'+icon('arrow'),'simulate','btn',H.finalAllowed(r.choices,r.flags,r.adjustment)?'':'disabled'),'FINAL DESIGN');}
function balance(s){return `<div class="water-balance"><b>WATER BALANCE / m³</b><span>${n(s.total)} inflow = ${n(s.drained)} discharged + ${n(H.sum(s.holding))} district storage + ${n(s.field)} pitch storage + ${n(H.sum(s.overflow))} overflow</span></div>`;}
function finalTrial(c){const r=R(),high=r.sim,s=r.compare?H.simulate(r.choices,r.adjustment,r.priority,'low'):high;return missionShell(c,`<section class="result-board final-results"><div class="board-header"><span class="eyebrow">${r.compare?'COMPARISON ONLY / OLD LOW RIVER':'DECISION TEST / CURRENT HIGH RIVER'}</span>${tag('100-MINUTE DRILL')}</div>${regions(s)}${chart(s)}${balance(s)}<div class="inline-actions">${btn(r.compare?'Return to today’s high river':'Compare with the old low river','compare','text-btn')}${btn('Round-by-round data','table','text-btn')}</div></section><aside class="case-panel"><span class="eyebrow">RECOMMENDATION / BASED ON HIGH RIVER</span><h2>${D.endings[high.ending].label.toLowerCase()}</h2><p>${D.endings[high.ending].text}</p><div class="callout">${high.firstSpill?'First overflow: minute '+high.firstSpill+'. Inspect that round before changing the design.':'No overflow in this test. Water remaining in storage still needs a later drainage plan.'}</div><div class="small-facts"><span><b>${high.budget}</b>credits remaining</span><span><b>${n(high.field)} m³</b>held in the pitch</span></div><p class="hint">Each district must have cumulative overflow ≤ 6 m³. This target belongs to the fictional classroom drill.</p></aside>`,btn(icon('back')+'Revise the final design','design','btn secondary'),btn('Submit for learning review'+icon('arrow'),'finish','btn'),'CURRENT-CONDITION TEST');}
function mission(c){const p=phase(c);return p==='survey'?survey(c):p==='lab'?lab(c):p==='explain'?explain(c):p==='design'?design(c):p==='council'?councilScreen(c):trial(c);}
const quiz=L.questions;
function quizScore(){return L.score(R());}
function evidenceReader(id,mode='dossier'){const z=D.evidence[id],r=R();return frame(`${heading(z.kind,z.title,'Use this record for the question it can answer.')}<div class="reader-layout"><div class="reader-art">${id==='camera'?camera():z.image?image('evidence/'+z.image,z.title):`<div class="paper-record"><span>STORMFRONT / FIELD RECORD</span><strong>${z.title}</strong><i></i><i></i><i></i><i></i><small>${z.kind}</small></div>`}</div><aside class="case-panel reader-text"><span class="eyebrow">OBSERVATION / NOT A COMPLETE EXPLANATION</span><p class="record-body">${z.text}</p>${id==='field'?portrait('manager','Agreement in principle is only the first step. Confirm restoration before activating the pitch.','vertical'):id==='merchants'?portrait('shopkeeper','Protect the street without pushing every cost onto someone else.','vertical'):id==='transport'?portrait('transport','A route reopening matters. So does an honest explanation of the route that stays closed.','vertical'):''}<span class="reader-status">✓ Recorded in your field journal</span></aside></div>`,bottom(btn(icon('back')+(mode==='journal'?'Back to the case':'Return to the investigation'),mode==='journal'?'back':'close-dossier','btn secondary'),mode==='journal'?`<div class="button-row">${btn('Previous','journal-prev','btn secondary',r.journalIndex?'':'disabled')}${btn('Next'+icon('arrow'),'journal-next','btn',r.journalIndex<r.evidence.length-1?'':'disabled')}</div>`:btn('Continue investigating'+icon('arrow'),'close-dossier'),'FIELD JOURNAL / '+(mode==='journal'?(r.journalIndex+1)+' OF '+r.evidence.length:'EVIDENCE RECORD')),id==='camera'?'evidence-reader camera-reader':'evidence-reader');}
function notebook(){const r=R();if(r.evidence.length){r.journalIndex=Math.min(r.journalIndex,r.evidence.length-1);return evidenceReader(r.evidence[r.journalIndex],'journal');}return frame(`${heading('FIELD JOURNAL','Your investigation starts with a question.')}<div class="empty-journal">${icon('book')}<h2>No evidence collected yet.</h2><p>Accept the case, inspect the wall and follow the water upstream.</p></div>`,bottom(btn(icon('back')+'Return','back','btn secondary')));}
function tablePage(){const r=R(),s=r.sim,start=(r.tableIndex||0)*5;return frame(`${heading('SIMULATION RECORD / CURRENT HIGH RIVER','Account for every cubic metre.','10 minutes per round. Overflow leaves the model and is not counted twice.')}<section class="table-board"><table><thead><tr><th>Minute</th><th>Plain</th><th>Hill</th><th>Discharged</th><th>Old St. held</th><th>Walk held</th><th>Pitch held*</th><th>Overflow</th></tr></thead><tbody>${s.rows.slice(start,start+5).map(a=>`<tr><th>${a.minute}</th><td>${n(a.plain)}</td><td>${n(a.hill)}</td><td>${n(a.drained)}</td><td>${n(a.oldHeld)}</td><td>${n(a.corridorHeld)}</td><td>${n(a.field)}</td><td>${n(a.oldSpill+a.corridorSpill)}</td></tr>`).join('')}</tbody></table>${balance(s)}<p class="hint">All water values in m³. *Pitch storage is cumulative. Tanks and pitch water need later drainage. This is a teaching model, not an engineering assessment.</p></section>`,bottom(btn(icon('back')+'Return to results','close-dossier','btn secondary'),btn(start?'Show minutes 10–50':'Show minutes 60–100','table-next','btn'),'DATA / ROUNDS '+(start+1)+'–'+(start+5)+' OF 10'));}
function councilResult(){return H.simulate(R().choices,'none','balanced','low');}
function councilMetrics(){const s=councilResult();return [{id:'peak',label:'Combined peak',value:n(s.peak)+' m³ / round',text:'Combined peak '+n(s.peak)+' m³ per round; old outlet limit 32 m³ per round.'},{id:'budget',label:'Funds reserved',value:(12-s.cost)+' credits',text:(12-s.cost)+' of 12 shared credits remain.'},{id:'overflow',label:'District overflow',value:n(s.overflow[0])+' / '+n(s.overflow[1])+' m³',text:'Old Street overflow '+n(s.overflow[0])+' m³; Transit Walk '+n(s.overflow[1])+' m³ in the low-river test.'}];}
function wordNote(field,text,min){return `<small class="word-note" data-word-count="${field}">${L.words(text)} / ${min} words minimum</small>`;}
function councilScreen(c){const r=R(),v=r.council,step=v.step||0,o=c.options.find(o=>o.id===r.choices.confluence),metrics=councilMetrics(),selected=metrics.find(x=>x.id===v.metric);const mode=v.mode==='pair'?'TWO-LEARNER REVIEW':'SOLO / SWITCH PERSPECTIVES';
const stages=['Propose','Challenge','Agree'];
let task='';
if(step===0)task=`<span class="eyebrow">ROLE 1 / DESIGNER</span><h2>Explain your proposal.</h2><p>Use the current design and budget. Explain why it serves the catchment, not just one location.</p><div class="mode-choices">${btn('Two learners','council-mode','chip '+(v.mode==='pair'?'selected':''),'data-id="pair"')}${btn('Solo self-review','council-mode','chip '+(v.mode==='solo'?'selected':''),'data-id="solo"')}</div><label class="field-label" for="proposal">Designer’s reason</label><textarea id="proposal" class="review-text" data-council-field="proposal" maxlength="700" placeholder="Why did you choose this proposal? Give a reason, not just its name.">${e(v.proposal)}</textarea>${wordNote('proposal',v.proposal,8)}<p class="hint">In pairs, the designer writes first. Alone, record your initial design perspective.</p>`;
if(step===1)task=`<span class="eyebrow">ROLE 2 / EVIDENCE CHECKER</span><h2>Challenge it with evidence.</h2><p>${v.mode==='pair'?'Pass the controls to your partner.':'Switch to the evidence-checker role.'} Read the proposal, select one result, then identify a constraint, cost or unresolved risk.</p><div class="metric-choices">${metrics.map(m=>btn(`<span>${m.label}</span><b>${m.value}</b>`,'council-metric','metric-chip '+(v.metric===m.id?'selected':''),`data-id="${m.id}"`)).join('')}</div><label class="field-label" for="challenge">Evidence checker’s question or concern</label><textarea id="challenge" class="review-text short" data-council-field="challenge" maxlength="700" placeholder="Use the selected datum to question a limit, trade-off or remaining risk.">${e(v.challenge)}</textarea>${wordNote('challenge',v.challenge,8)}`;
if(step===2)task=`<span class="eyebrow">JOINT DECISION / RESPOND TO THE CHALLENGE</span><h2>Agree, or revise the design.</h2><p>${v.mode==='pair'?'Discuss the concern together.':'Compare the two perspectives.'} Explain how the proposal addresses it, or why a limit remains acceptable for this test.</p><label class="field-label" for="agreement">Agreed response and next action</label><textarea id="agreement" class="review-text" data-council-field="agreement" maxlength="700" placeholder="What will you keep, change, or check next? Explain the agreement.">${e(v.agreement)}</textarea>${wordNote('agreement',v.agreement,6)}<div class="callout">Need to change the plan? Revise and retest before recording a new agreement.</div>`;
return missionShell(c,`<section class="case-panel council-context"><span class="eyebrow">COLLABORATIVE PROBLEM-SOLVING</span><h2>A proposal needs a second perspective.</h2><div class="review-stages">${stages.map((t,i)=>`<span class="${i===step?'active':i<step?'done':''}"><b>0${i+1}</b>${t}</span>`).join('')}</div><div class="proposal-card"><span>CURRENT PROPOSAL</span><h3>${o.sub}</h3><p>${o.detail}</p></div>${step>0?`<div class="record-quote"><b>Designer’s reason</b><p>${e(v.proposal)}</p></div>`:portrait('engineer','One person proposes. The other checks the evidence. Record how you reach the decision.')} ${step===2?`<div class="record-quote"><b>Checker’s evidence</b><p>${selected?selected.text:''}</p><p>${e(v.challenge)}</p></div>`:''}<span class="mode-label">${v.mode?mode:'CHOOSE A WORKING MODE'}</span></section><section class="case-panel council-task">${task}</section>`,step?btn(icon('back')+'Previous role','council-prev','btn secondary'):btn(icon('back')+'Revise the design','council-edit-design','btn secondary'),btn((step===2?(r.councilReturn==='Debrief'?'Record & return to review':'Agree & travel to the centre'):step===0?'Pass to the evidence checker':'Discuss a joint response')+icon('arrow'),step===2?'approve-council':'council-next','btn',L.councilStepReady(r,step)?'':'disabled'),'DESIGN REVIEW');}
function reportMetrics(){const s=R().sim;return [{id:'inflow',label:'Total inflow',value:n(s.total)+' m³'},{id:'old',label:'Old Street overflow',value:n(s.overflow[0])+' m³'},{id:'walk',label:'Transit Walk overflow',value:n(s.overflow[1])+' m³'},{id:'held',label:'Still in storage',value:n(H.sum(s.holding)+s.field)+' m³'}];}
function report(){const r=R(),s=r.sim,part=r.reportPage||0,m=reportMetrics().find(x=>x.id===r.reportMetric);let content;
if(!part)content=`<section class="case-panel report-connect"><span class="eyebrow">1 / CONNECT THE FLOW PATH</span><h2>Bring the upstream and downstream together.</h2>${[['connected','Upstream surfaces → hillside tributary → confluence → district storage → constrained outlet'],['local','Old Street → bigger pipe; upstream places and river level do not affect the result']].map(([id,t])=>btn(t,'report-path','answer '+(r.answers.path===id?'selected':''),`data-id="${id}"`)).join('')}<div class="feedback ${r.answers.path==='local'?'revise':'neutral'}">${r.answers.path==='connected'?'This path connects the catchment. Next, select a value from your current high-river test.':r.answers.path==='local'?'A local pipe alone leaves upstream inflow and outlet conditions unexplained. Reconnect the whole system.':'Select the path that explains the whole drainage system.'}</div></section><section class="case-panel report-select"><span class="eyebrow">2 / CHOOSE YOUR EVIDENCE</span><h2>Which result supports your explanation?</h2><div class="report-metrics">${reportMetrics().map(x=>btn(`<span>${x.label}</span><b>${x.value}</b>`,'report-metric','metric-chip '+(r.reportMetric===x.id?'selected':''),`data-id="${x.id}"`)).join('')}</div><p class="hint">These are your current test results. The chosen datum is attached to your statement in the case report.</p></section>`;
else content=`<section class="case-panel report-writing"><label class="field-label" for="explanation">3 / Explain how your design produced this result</label><textarea id="explanation" class="review-text" maxlength="1200" placeholder="Connect the selected result to runoff, flow timing, storage or the constrained outlet.">${e(r.explanation)}</textarea>${wordNote('explanation',r.explanation,12)}<label class="field-label" for="followup">4 / Explain the cost, remaining risk or later work</label><textarea id="followup" class="review-text short" maxlength="900" placeholder="Discuss credits, a closed district, stored water, pitch restoration, or why no extra work was needed in this test.">${e(r.followup)}</textarea>${wordNote('followup',r.followup,6)}<span class="hint" id="report-saved">Draft saved automatically on this device.</span></section><section class="case-panel report-rubric"><span class="eyebrow">YOUR CHOSEN EVIDENCE</span><div class="chosen-result"><span>${m?m.label:'Choose a result first'}</span><strong>${m?m.value:'—'}</strong></div><h2>Build your explanation.</h2><ol class="reasoning-prompts"><li><b>What did you change?</b><span>Connect the design decision to runoff, timing, storage or the outlet.</span></li><li><b>Which result supports it?</b><span>Use your selected value and explain what it shows.</span></li><li><b>What remains to be managed?</b><span>Identify a cost, remaining risk or follow-up responsibility.</span></li></ol><div class="callout">The game checks submission completeness. Your teacher or partner reviews the scientific quality of your explanation.</div></section>`;
return frame(`${heading('LEARNING REVIEW / EVIDENCE-BASED CASE STATEMENT',part?'Explain the decision and its consequences.':'Choose a path. Attach a test result.')}<div class="report-layout">${content}</div>`,bottom(btn(icon('back')+(part?'Back to path & data':'Review checklist'),part?'report-prev':'review-summary','btn secondary'),btn((part?'Record the case statement':'Write the explanation')+icon('arrow'),part?'submit-report':'report-next','btn',(part?L.reportDraftReady(r):(r.answers.path==='connected'&&!!m))?'':'disabled')));}
function knowledge(){const r=R(),q=quiz[r.quizIndex],a=r.quiz[q.id],correct=a===q.correct;return frame(`${heading('LEARNING REVIEW / KNOWLEDGE CHECK','Defend the recommendation.')}<div class="knowledge-layout"><div class="question-number"><span>QUESTION</span><strong>0${r.quizIndex+1}<small>/ 04</small></strong><h2>${q.q}</h2><span class="score-tag">${quizScore()} / 4 checked with feedback</span></div><section class="case-panel quiz-panel">${q.options.map((t,i)=>btn(t,'quiz-answer','answer '+(a===i?'selected':''),`data-id="${i}"`)).join('')}${a!=null?`<div class="feedback ${correct?'good':'revise'}"><b>${correct?'Supported by the evidence.':'Recheck and revise your answer.'}</b><p>${q.why}</p></div>`:'<div class="callout">Choose an answer. Use the feedback to revise it before continuing.</div>'}</section></div>`,bottom(btn(icon('back')+(r.quizIndex?'Previous question':'Review checklist'),r.quizIndex?'quiz-prev':'review-summary','btn secondary'),btn((r.quizIndex===3?'Continue to the case statement':'Next question')+icon('arrow'),r.quizIndex===3?'quiz-to-report':'quiz-next','btn',(correct&&(r.quizIndex<3||L.quizComplete(r)))?'':'disabled')));}
function reviewExcerpt(text,empty){return e(String(text||'').trim()||empty);}
function reviewSummary(){
  const r=R(),g=L.reviewGuide(r),{council:c,quiz:q,report:p}=g.complete;
  const a=L.explanationCorrect(r,'baishi')&&L.explanationCorrect(r,'qingling');
  const datum=r.choices.confluence?councilMetrics().find(x=>x.id===r.council.metric):null;
  const metric=L.testKey(r)?reportMetrics().find(x=>x.id===r.reportMetric):null;
  const mode=r.council.mode==='pair'?'Paired review':r.council.mode==='solo'?'Solo self-review':'';
  const state=key=>g.complete[key]?'complete':g.next.key===key?'active':'pending';
  const marker=key=>g.complete[key]?`<span class="record-state complete">${icon('check')}Recorded</span>`:g.next.key===key?'<span class="record-state active">NEXT</span>':'<span class="record-state">TO DO</span>';
  const note=(done,text)=>`<p class="completion-note ${done?'saved':'needed'}">${done?'':'<b>Next:</b> '}${e(text)}</p>`;
  const topics={control:'Fair comparison',travel:'Travel time',storage:'Stored water',transfer:'System transfer'};
  return frame(`${heading('FINAL LEARNING REVIEW','A tested design. A supported explanation.')}
    <div class="review-intro ${g.next.key==='close'?'ready':''}">
      <div><p>Complete the learning record before closing the case. The engineering outcome remains based on your storm test.</p><p class="review-next"><b>${g.next.key==='close'?'Ready to close:':'Next step:'}</b> ${e(g.next.hint)}</p></div>
      <div class="record-count"><strong>${g.count}<span> / 3</span></strong><span>learning records complete</span></div>
    </div>
    <div class="completion-grid">
      <section class="case-panel completion-card ${state('council')}" aria-label="Design review">
        <div class="completion-card-top"><span class="eyebrow">01 / DESIGN REVIEW</span>${marker('council')}</div>
        <h2>${c?'Decision recorded':'Review the proposal'}</h2>
        <dl class="summary-evidence"><div><dt>Designer’s reason</dt><dd>${reviewExcerpt(r.council.proposal,'No reason recorded yet.')}</dd></div><div><dt>Checker’s datum · low-river test</dt><dd>${datum?e(datum.label+' · '+datum.value):'No test datum selected yet.'}</dd></div></dl>
        ${note(c,c?mode+' · Reason, challenge and joint response saved.':g.councilNeed)}
        ${btn(c?'Read the role review':'Complete the role review','review-council','btn secondary full')}
      </section>
      <section class="case-panel completion-card ${state('quiz')}" aria-label="Knowledge check">
        <div class="completion-card-top"><span class="eyebrow">02 / KNOWLEDGE</span>${marker('quiz')}</div>
        <h2>${quizScore()} of 4 checked</h2>
        <ul class="summary-questions">${quiz.map(x=>`<li class="${r.quiz[x.id]===x.correct?'checked':''}"><span aria-label="${r.quiz[x.id]===x.correct?'Checked':'To revisit'}">${r.quiz[x.id]===x.correct?'✓':'○'}</span>${topics[x.id]}</li>`).join('')}</ul>
        <p class="knowledge-note">Use feedback to support each response.</p>
        ${note(q,q?'All four supported responses recorded.':`${4-quizScore()} response${quizScore()===3?'':'s'} still need checking with the evidence.`)}
        ${btn(q?'Revisit the questions':'Complete the knowledge check','open-quiz','btn secondary full')}
      </section>
      <section class="case-panel completion-card ${state('report')}" aria-label="Case statement">
        <div class="completion-card-top"><span class="eyebrow">03 / CASE STATEMENT</span>${marker('report')}</div>
        <h2>${p?'Evidence attached':'Explain your result'}</h2>
        <dl class="summary-evidence"><div><dt>Selected test evidence</dt><dd>${metric?e(metric.label+' · '+metric.value):'No current test datum attached.'}</dd></div><div><dt>Follow-up responsibility</dt><dd>${reviewExcerpt(r.followup,'No follow-up recorded yet.')}</dd></div></dl>
        ${note(p,g.reportNeed)}
        ${btn(p?'Read the statement':'Complete the statement',L.testKey(r)?'continue-report':'review-continue','btn secondary full')}
      </section>
    </div>
    <div class="process-check"><span>${a?'✓ Surface and travel-time explanations checked.':'Earlier explanations need revision.'}</span>${!L.explanationCorrect(r,'baishi')?btn('Recheck surfaces','recheck-explanation','text-btn','data-id="baishi"'):''}${!L.explanationCorrect(r,'qingling')?btn('Recheck travel time','recheck-explanation','text-btn','data-id="qingling"'):''}<span>Written reasoning is available for teacher or peer review.</span></div>`,
    bottom(btn(icon('back')+'Revisit the storm test','return-test','btn secondary'),btn(e(g.next.label)+icon('arrow'),'review-continue','btn')),'review-summary');
}
function debrief(){const r=R();return r.reviewStep==='quiz'?knowledge():r.reviewStep==='report'?report():reviewSummary();}
function ending(){const r=R(),s=r.sim,z=D.endings[s.ending];return frame(`${heading('CASE CLOSED / '+z.label,z.title)}<div class="ending-layout"><div class="ending-art">${image('endings/'+z.image,z.label)}<div class="ending-caption"><span>${tag('OLD STREET / '+(s.pass[0]?'OPEN':'CLOSED'),s.pass[0]?'ok':'closed')}${tag('TRANSIT WALK / '+(s.pass[1]?'OPEN':'CLOSED'),s.pass[1]?'ok':'closed')}</span><p>${z.text}</p></div></div><aside class="case-panel ending-panel">${portrait(z.person,z.quote,'vertical')}<div class="ending-links">${btn('Read the learning record'+icon('arrow'),'review-summary','btn secondary full')}${btn('Read the case statement','open-report','btn secondary full')}${btn('Try another upstream design','replan','text-btn')}</div><p class="hint">Learning review complete. Your engineering result and learning evidence are both recorded.</p></aside></div>`,bottom(btn(icon('back')+'Title screen','home','btn secondary'),btn(icon('download')+'Export case report','export')));}
const courseOverview=()=>`<div class="about-page">${heading('ABOUT THE COURSE','Investigate. Test. Explain. Decide.')}<div class="course-layout"><section class="case-panel course-facts-panel"><span class="eyebrow">URBAN STORMWATER DESIGN</span><p class="course-description">${D.description}</p><p class="course-branch"><b>Primary STEM branch:</b> Environmental / Civil Engineering.<br>Integrates science, technology and mathematics.</p><p class="course-genre"><b>Game type:</b> Branching investigation and engineering simulation. For lower secondary learners and above.</p><span class="eyebrow">LEARNING OBJECTIVES</span><ol class="compact-objectives"><li>Use a fair comparison to explain surface runoff.</li><li>Trace flow paths and overlapping arrival times.</li><li>Design and retest within a 12-credit shared budget.</li><li>Justify a trade-off with a path, data and follow-up responsibility.</li></ol></section><section class="case-panel strategy-panel"><span class="eyebrow">LEARNING STRATEGY / SCENARIO-BASED LEARNING</span><h2>Make decisions inside a connected story.</h2><p>A watermark mystery creates the challenge. Evidence develops the story. Choices persist as water, timing, budget and community access; one final storm tests their consequences.</p><span class="eyebrow strategy-subhead">5E INQUIRY / HOW THE STRATEGY IS APPLIED</span><div class="strategy-rows">${[['Engage','Predict why the higher watermark followed a pipe upgrade.'],['Explore','Compare grass and asphalt with equal rain, area and duration.'],['Explain','Use runoff data and camera timing; revise unsupported claims.'],['Elaborate','Transfer the principles across cities. A designer and evidence checker review the shared-budget proposal.'],['Evaluate','Retest at high river level, complete the knowledge check, and submit a data-based case statement.']].map(([a,b])=>`<div><b>${a}</b><p>${b}</p></div>`).join('')}</div><p class="strategy-note">Learners can revisit evidence and retest. In pairs, pass the controls between roles; alone, record both perspectives.</p></section></div><p class="image-credit">Image source: <b>Recraft</b> — 18 AI-assisted illustrations generated and edited for this game. Learning design draws on the course SBL and 5E materials.</p></div>`;
function about(){return frame(courseOverview(),bottom(btn(icon('back')+'Return to game','back','btn secondary')),'about-screen');}

function openReview(step){R().reviewStep=step;R().dossier=null;R().explanationReturn=null;save();if(State.passage==='Debrief')render();else go('Debrief');}
function render(){const roots=document.querySelectorAll('#game-root'),root=roots[roots.length-1];if(!root)return;const r=R(),p=State.passage;if(pages.includes(p))r.checkpoint=p;const c=C();root.innerHTML=r.dossier==='table'?tablePage():r.dossier?evidenceReader(r.dossier):p==='Start'?home():p==='Briefing'?briefing():p==='About'?about():p==='Notebook'?notebook():p==='Debrief'?debrief():p==='Ending'?(L.caseClosed(r)?ending():debrief()):c?mission(c):home();fit();save();}
function simulate(c){const r=R();if(c.key==='review'&&!H.finalAllowed(r.choices,r.flags,r.adjustment))return;const b=document.querySelector('.passage:last-child [data-action="simulate"]');if(b){b.disabled=true;b.textContent='Replaying the storm…';}clearTimeout(timer);timer=setTimeout(()=>{r.sim=H.simulate(r.choices,c.key==='review'?r.adjustment:'none',c.key==='review'?r.priority:'balanced',c.key==='review'?'high':'low');r.simChapter=c.key;r.reportAcceptedFor=null;r.learningClosedFor=null;r.phase[c.key]='trial';r.compare=false;save();render();},350);}
async function audio(){const r=R();try{if(!sound){const A=window.AudioContext||window.webkitAudioContext,ctx=new A(),buf=ctx.createBuffer(1,ctx.sampleRate*3,ctx.sampleRate),d=buf.getChannelData(0);let last=0;for(let i=0;i<d.length;i++){last=(last+.04*(Math.random()*2-1))/1.04;d[i]=last*3;}const source=ctx.createBufferSource(),gain=ctx.createGain(),filter=ctx.createBiquadFilter();source.buffer=buf;source.loop=true;filter.type='lowpass';filter.frequency.value=1400;gain.gain.value=.11;source.connect(filter);filter.connect(gain);gain.connect(ctx.destination);source.start();sound={ctx};}r.audio=!r.audio;if(r.audio)await sound.ctx.resume();else await sound.ctx.suspend();save();render();}catch(_){r.audio=false;toast('Audio unavailable. You can play the full case without sound.');}}
function exportReport(){const r=R(),s=r.sim;let t='STORMFRONT / THE THREE-CITY DRAINAGE CASE\n'+new Date().toLocaleString('en-GB')+'\n\nEnding: '+D.endings[s.ending].label+'\n';chapters.slice(0,3).forEach(c=>{t+=c.city+': '+c.options.find(o=>o.id===r.choices[c.key]).sub+'\n';});t+='Hillside location: '+r.choices.placement+'\nFinal adjustment: '+finalOptions().find(o=>o.id===r.adjustment).sub+'\nOutlet allocation: '+r.priority+'\nShared spending: '+(s.cost+s.finalCost)+'/12 credits\nPitch restoration promised: '+!!r.flags.restorePromise+'\n';t+='\nHIGH RIVER TEST / 16 m3 per round\nOld Street overflow: '+n(s.overflow[0])+' m3\nTransit Walk overflow: '+n(s.overflow[1])+' m3\nInflow '+n(s.total)+' = discharged '+n(s.drained)+' + district storage '+n(H.sum(s.holding))+' + pitch storage '+n(s.field)+' + overflow '+n(H.sum(s.overflow))+' m3\n';t+='\nEVIDENCE\n'+r.evidence.map(id=>D.evidence[id].title+': '+D.evidence[id].text).join('\n');t+='\n\nCONTROLLED EXPERIMENT\nRain: '+r.lab.rain+' mm. Each surface: 1000 m2, 30 minutes. Asphalt runoff: '+n(H.runoff(r.lab.rain,1000,.9))+' m3. Grass: '+n(H.runoff(r.lab.rain,1000,.25))+' m3.\nSurface explanation: '+(r.answers.baishi||'not recorded')+'\nTravel-time explanation: '+(r.answers.qingling||'not recorded')+'\nSystem path: '+(r.answers.path||'not recorded')+'\n';t+='\nCASE STATEMENT\n'+(r.explanation||'Not yet completed.')+'\n\nKNOWLEDGE CHECK / '+quizScore()+'/4\n'+quiz.map(q=>q.q+'\nResponse: '+(r.quiz[q.id]!=null?q.options[r.quiz[q.id]]:'Not answered')+'\nSupported: '+(r.quiz[q.id]===q.correct)).join('\n');t+='\n\nFOLLOW-UP RESPONSIBILITY\n'+r.followup+'\nChosen final datum: '+reportMetrics().find(x=>x.id===r.reportMetric)?.label+' / '+reportMetrics().find(x=>x.id===r.reportMetric)?.value+'\n\nDESIGN REVIEW\nMode: '+(r.council.mode==='pair'?'Paired review (reported)':'Solo self-review')+'\nDesigner: '+r.council.proposal+'\nChecker datum: '+councilMetrics().find(x=>x.id===r.council.metric)?.text+'\nChecker concern: '+r.council.challenge+'\nAgreed response: '+r.council.agreement+'\nLearning review complete: '+L.caseClosed(r)+'\n\nQUESTION RESPONSES\n'+quiz.map(q=>q.id+': first recorded choice='+(r.quizFirst[q.id]==null?'not recorded':r.quizFirst[q.id]+1)+', recorded attempts='+(r.quizAttempts[q.id]||0)+', final choice='+(r.quiz[q.id]+1)).join('\n');t+='\n\nROUND DATA / m3\nMinute,Plain,Hill,Discharged,OldStHeld,WalkHeld,PitchHeld,OldStOverflow,WalkOverflow\n'+s.rows.map(a=>[a.minute,a.plain,a.hill,a.drained,a.oldHeld,a.corridorHeld,a.field,a.oldSpill,a.corridorSpill].map(n).join(',')).join('\n');t+='\n\nFictional teaching model. Stored water still needs later drainage. Opening targets do not apply to real engineering decisions.';const a=document.createElement('a'),url=URL.createObjectURL(new Blob([t],{type:'text/plain;charset=utf-8'}));a.href=url;a.download='Stormfront-Case-Report.txt';a.click();setTimeout(()=>URL.revokeObjectURL(url),1000);toast('Case report exported.');}
$(document).on(':passagedisplay',()=>{clearTimeout(timer);if(boot){State.variables.run=clone(loaded);boot=false;}R().audio=!!(sound&&sound.ctx.state==='running');render();});

function updateEntryGates(){const r=R(),scope=document.querySelector('.passage:last-child');if(!scope)return;for(const [name,min] of [['proposal',8],['challenge',8],['agreement',6],['explanation',12],['followup',6]]){const el=scope.querySelector('[data-word-count="'+name+'"]');if(el)el.textContent=L.words(['proposal','challenge','agreement'].includes(name)?r.council[name]:r[name])+' / '+min+' words minimum';}for(const action of ['council-next','approve-council']){const b=scope.querySelector('[data-action="'+action+'"]');if(b)b.disabled=!L.councilStepReady(r,r.council.step||0);}const reportButton=scope.querySelector('[data-action="submit-report"]');if(reportButton)reportButton.disabled=!L.reportDraftReady(r);const status=scope.querySelector('#report-saved');if(status)status.textContent='Draft saved on this device.';}

window.addEventListener('resize',fit);
document.addEventListener('click',ev=>{const el=ev.target.closest('[data-action]');if(!el||el.disabled)return;let a=el.dataset.action,id=el.dataset.id;const r=R(),c=C();
if(a==='review-continue'){const next=L.reviewGuide(r).next;a=next.action;id=next.id;}
if(a==='begin'){r.begun=true;addEvidence('watermarks');return go('Briefing');}
if(a==='resume')return go(r.checkpoint);
if(a==='home')return go('Start');
if(a==='about'||a==='journal'){if(!['About','Notebook'].includes(State.passage))r.returnTo=State.passage;r.dossier=null;return go(a==='about'?'About':'Notebook');}
if(a==='back')return go(r.returnTo||'Start');
if(a==='sound')return void audio();
if(a==='reset')return document.getElementById('reset-dialog').showModal();
if(a==='cancel-reset')return document.getElementById('reset-dialog').close();
if(a==='confirm-reset'){State.variables.run=fresh();R().begun=true;addEvidence('watermarks');save();return go('Briefing');}
if(a==='hypothesis')r.answers.hypothesis=id;
if(a==='start')return go('Baishi');
if(a==='node')r.node[c.key]=id;
if(a==='clue'){addEvidence(id);if(!r.first[c.key])r.first[c.key]=id;if(id==='field')r.flags.fieldAgreement=true;r.dossier=id;}
if(a==='close-dossier')r.dossier=null;
if(a==='record-report'){addEvidence('report');r.dossier='report';}
if(a==='next-survey')return setPhase(c.key==='baishi'?'lab':c.key==='qingling'?'explain':'design');
if(a==='back-survey')return setPhase('survey');
if(a==='back-lab')return setPhase('lab');
if(a==='rain'){r.lab.rain=Number(id);r.lab.done=false;delete r.answers.baishi;}
if(a==='lab')r.lab.done=true;
if(a==='explain')return setPhase('explain');
if(a==='explanation-choice'){r.answers[c.key]=id;r.learningClosedFor=null;}
if(a==='design'){if(phase(c)==='explain'&&!L.explanationCorrect(r,c.key))return toast('Use the feedback to revise your explanation.');if(r.explanationReturn)return openReview('summary');return setPhase('design');}
if(a==='select'){r.choices[c.key]=id;invalidate();}
if(a==='placement'){r.choices.placement=id;invalidate();}
if(a==='camera-frame')r.frame=Number(id);
if(a==='simulate')return simulate(c);
if(a==='commit'){if(!r.sim||r.simChapter!==c.key)return;if(c.key==='confluence'){r.councilReturn='Review';r.council.step=0;r.phase.confluence='council';save();render();return;}return go(chapters[chapters.indexOf(c)+1].id);}
if(a==='review-method'){r.reviewMethod=id;addEvidence('report');}
if(a==='priority'){r.priority=id;invalidate();}
if(a==='adjustment'){if(!H.finalAllowed(r.choices,r.flags,id))return;r.adjustment=id;invalidate();}
if(a==='compare')r.compare=!r.compare;
if(a==='table'){r.tableIndex=0;r.dossier='table';}
if(a==='table-next')r.tableIndex=r.tableIndex?0:1;
if(a==='finish'){if(r.simChapter!=='review')return;r.quizIndex=L.firstMissingQuestion(r);return openReview(L.quizComplete(r)?'summary':'quiz');}
if(a==='open-report'||a==='continue-report'){const checks=L.reportChecks(r);if(!checks.simulation){r.phase.review='design';return go('Review');}r.reportPage=a==='continue-report'&&!L.reportComplete(r)&&checks.path&&checks.metric?1:0;return openReview('report');}
if(a==='open-quiz'){r.quizIndex=L.firstMissingQuestion(r);return openReview('quiz');}
if(a==='ending-page')return openReview('summary');
if(a==='report-path'){r.answers.path=id;r.reportAcceptedFor=null;r.learningClosedFor=null;}
if(a==='quiz-answer'){const q=quiz[r.quizIndex];if(!Object.prototype.hasOwnProperty.call(r.quizFirst,q.id))r.quizFirst[q.id]=Number(id);r.quizAttempts[q.id]=(r.quizAttempts[q.id]||0)+1;r.quiz[q.id]=Number(id);r.learningClosedFor=null;}
if(a==='quiz-prev')r.quizIndex=Math.max(0,r.quizIndex-1);
if(a==='quiz-next'){if(r.quiz[quiz[r.quizIndex].id]!==quiz[r.quizIndex].correct)return;r.quizIndex=Math.min(3,r.quizIndex+1);}
if(a==='journal-prev')r.journalIndex=Math.max(0,r.journalIndex-1);
if(a==='journal-next')r.journalIndex=Math.min(r.evidence.length-1,r.journalIndex+1);
if(a==='export'){if(!L.caseClosed(r))return toast('Complete the learning review before exporting the final case.');return exportReport();}
if(a==='replan'){delete r.choices.confluence;r.phase.confluence='survey';r.phase.review='survey';r.adjustment='none';r.priority='balanced';r.reviewMethod=null;r.flags.restorePromise=false;r.endPage='ending';r.council.approvedFor=null;r.council.step=0;r.councilReturn=null;invalidate();return go('Confluence');}
if(a==='review-summary')return openReview('summary');
if(a==='council-mode'){r.council.mode=id;r.council.approvedFor=null;r.learningClosedFor=null;}
if(a==='council-metric'){r.council.metric=id;r.council.approvedFor=null;r.learningClosedFor=null;}
if(a==='council-next'){if(!L.councilStepReady(r,r.council.step||0))return;r.council.step=Math.min(2,(r.council.step||0)+1);}
if(a==='council-prev')r.council.step=Math.max(0,(r.council.step||0)-1);
if(a==='council-edit-design'){r.councilReturn='Review';r.council.approvedFor=null;return setPhase('design');}
if(a==='approve-council'){if(!L.councilDraftReady(r))return;r.council.approvedFor=L.designKey(r);r.learningClosedFor=null;if(r.councilReturn==='Debrief')return openReview('summary');addEvidence('report');r.adjustment='none';r.priority='balanced';r.phase.review='survey';r.reviewMethod=null;r.sim=null;r.simChapter=null;r.reportAcceptedFor=null;r.compare=false;return go('Review');}
if(a==='review-council'){r.councilReturn='Debrief';r.council.step=L.councilComplete(r)?0:L.nextCouncilStep(r);r.phase.confluence='council';return go('Confluence');}
if(a==='report-metric'){r.reportMetric=id;r.reportAcceptedFor=null;r.learningClosedFor=null;}
if(a==='report-next'){if(r.answers.path!=='connected'||!reportMetrics().some(x=>x.id===r.reportMetric))return;r.reportPage=1;}
if(a==='report-prev')r.reportPage=0;
if(a==='submit-report'){if(!L.reportDraftReady(r))return;r.reportAcceptedFor=L.testKey(r);return openReview('summary');}
if(a==='quiz-to-report'){if(!L.quizComplete(r))return;r.reportPage=0;return openReview('report');}
if(a==='complete-case'){if(!L.canComplete(r))return toast('Complete the review checklist first.');r.learningClosedFor=L.testKey(r);return go('Ending');}
if(a==='return-test'){r.phase.review=L.testKey(r)?'trial':'design';return go('Review');}
if(a==='recheck-explanation'){r.explanationReturn='Debrief';r.phase[id]='explain';return go(id==='baishi'?'Baishi':'Qingling');}

save();render();});
document.addEventListener('change',ev=>{if(ev.target.id==='restore'){R().flags.restorePromise=ev.target.checked;if(!ev.target.checked&&R().adjustment==='field')R().adjustment='none';invalidate();save();render();}});
document.addEventListener('input',ev=>{const el=ev.target,r=R();if(el.dataset.councilField){r.council[el.dataset.councilField]=el.value;r.council.approvedFor=null;r.learningClosedFor=null;}else if(el.id==='explanation'||el.id==='followup'){r[el.id]=el.value;r.reportAcceptedFor=null;r.learningClosedFor=null;}else return;save();updateEntryGates();});
})();
