 options:[{id:'intercept',title:'Catch it on the slope',sub:'Intercept & infiltrate',cost:4,tag:'REDUCE INFLOW',detail:'Intercept the main gully. Reduce hillside runoff entering the network by 40%.'},{id:'detain',title:'Move the peak later',sub:'30 m³ foothill storage',cost:3,tag:'CONTROL TIMING',detail:'Release 10 m³ per round from minute 50. Keep total water volume unchanged.'},{id:'bypass',title:'Open a faster way out',sub:'Bypass to the tributary',cost:1,tag:'EARLIER ARRIVAL',detail:'Send hillside runoff one round earlier. Check whether downstream peaks overlap.'}]},
 {id:'Confluence',key:'confluence',no:'03',city:'Huiwan fringe',title:'Two passes. One overloaded junction.',terrain:'Mixed terrain / Systems & negotiation',time:'12 HOURS BEFORE THE DRILL',image:'03-huiwan-confluence',person:'manager',question:'Each tributary passed alone. Will they pass when their flows meet?',quote:'The pitch could hold water for the neighbourhood. But tomorrow’s match matters too. Agree on closure and restoration before using it.',clues:['merchants','transport','field'],
 nodes:[{id:'hill',x:20,y:20,label:'Qingling inflow',desc:'The volume and arrival time reflect your hillside decision.'},{id:'plain',x:16,y:65,label:'Baishi inflow',desc:'Your surface or storage choice changes the plain’s contribution.'},{id:'join',x:38,y:44,label:'Confluence',desc:'Add flows arriving in the same round. Separate pass records are not enough.'},{id:'field',x:64,y:41,label:'Community pitch',desc:'Temporary storage needs consent, a postponed match and a restoration plan.'},{id:'city',x:69,y:76,label:'City entrance',desc:'Shared engineering budget: 12 credits. Unspent funds carry into the final decision.'}],paths:['M200 200 Q270 340 380 440','M160 650 Q280 580 380 440','M380 440 Q510 620 690 760','M380 440 Q510 490 640 410'],
